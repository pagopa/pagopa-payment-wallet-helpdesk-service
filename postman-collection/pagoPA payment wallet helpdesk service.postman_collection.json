	"item": [
		{
			"name": "Get service info",
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/info",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"info"
					]
				}
			},
			"response": []
		},
		{
			"name": "Reset wallet deactivation retry counter",
			"request": {
				"method": "PATCH",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/helpdesk/wallets/{{wallet-id}}/deactivationRetryCount",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"helpdesk",
						"wallets",
						"{{wallet-id}}",
						"deactivationRetryCount"
					]
				},
				"description": "Set deactivationRetryCount to zero on an existing wallet. Use a canonical lowercase UUID for wallet-id. No body is required. Success returns 204, including when the counter is already zero."
			},
			"response": []
		},
		{
			"name": "Get wallets",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/helpdesk/wallets/{{x-user-id}}?type=CARDS&status=VALIDATED",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"helpdesk",
						"wallets",
						"{{x-user-id}}"
					],
					"query": [
						{
							"key": "type",
							"value": "CARDS"
						},
						{
							"key": "status",
							"value": "VALIDATED"
						},
						{
							"key": "",
							"value": "",
							"disabled": true
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Search contract deactivation DLQ",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/helpdesk/wallets/contractId/deactivations/dlq?pageSize=10",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"helpdesk",
						"wallets",
						"contractId",
						"deactivations",
						"dlq"
					],
					"query": [
						{
							"key": "pageSize",
							"value": "10"
						},
						{
							"key": "continuationCursor",
							"value": "{{continuationCursor}}",
							"disabled": true
						}
					]
				},
				"description": "Use the continuationCursor returned by the previous page to fetch the next page."
			},
			"response": []
		}
	]
